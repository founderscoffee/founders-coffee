{
  "description": "founders.coffee production server-function edge volume limit",
  "expression": "(http.host eq \"founders.coffee\" and starts_with(http.request.uri.path, \"/_serverFn/\"))",
  "action": "block",
  "ratelimit": {
    "characteristics": ["cf.colo.id", "ip.src"],
    "period": 60,
    "requests_per_period": 120,
    "mitigation_timeout": 60
  }
}
