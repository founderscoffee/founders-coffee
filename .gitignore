# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# ── Compiled output / build artifacts ──
dist
tmp
out-tsc
build
.output
.wrangler

# ── Dependencies ──
node_modules

# ── TypeScript incremental build info ──
*.tsbuildinfo

# ── Generated code (regenerated by tooling — do not commit) ──
**/routeTree.gen.ts
**/routeTree.gen.js
**/worker-configuration.d.ts
libs/i18n/src/paraglide/
public/sw*
public/swe-worker*

# ── Vite / Vitest cache ──
.vite
.vitest

# ── Test coverage ──
/coverage
test-output

# ── Env / secrets (never commit) ──
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# ── Lint / tool caches ──
.eslintcache
.cache
.turbo

# ── Logs ──
*.log
npm-debug.log*
yarn-error.log
testem.log

# ── IDEs and editors ──
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode (keep shared settings, ignore the rest)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── Misc ──
/.sass-cache
/connect.lock
/libpeerconnection.log
/typings

# ── Nx ──
.nx/cache
.nx/workspace-data
.nx/migrate-runs

# ── Claude Code ──
.claude/worktrees
.claude/settings.local.json

# ── System Files ──
.DS_Store
Thumbs.db
firebase-service-account.json
test-results/
playwright-report/
