{
  "name": "public-test",
  "main": "./src/server.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "APP_URL": "https://staging.founders.coffee",
    "APP_ENVIRONMENT": "staging",
    "MAIL_FROM": "no-reply@founders.coffee",
    "BETTER_AUTH_SECRET": "test-secret-at-least-thirty-two-characters-long",
    "TURNSTILE_DISABLED": "true",
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "db", "database_id": "test" },
  ],
  "r2_buckets": [
    { "binding": "PROFILE_ASSETS", "bucket_name": "profile-assets-test" },
  ],
  "images": { "binding": "IMAGES" },
  "send_email": [
    { "name": "EMAIL", "allowed_destination_addresses": ["ok@example.com"] },
  ],
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "founders-coffee-metrics" },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "EVENT_LIVE", "class_name": "EventLiveDO" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiterDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EventLiveDO"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimiterDO"] },
  ],
}
