# Everything under /assets carries a content hash in its filename (Vite emits nothing unhashed
# there), so a changed file is a new URL and the old one can never be wrong. Without this the
# Workers assets default is `max-age=0, must-revalidate`, which spends a round-trip revalidating
# a file that by construction cannot have changed. Unhashed assets — favicons, the manifest, the
# mapbox worker — are deliberately left on the default.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
