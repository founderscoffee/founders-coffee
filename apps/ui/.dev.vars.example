# apps/ui local dev SECRETS — copy to `.dev.vars` (gitignored) and fill in.
# APP_URL is NOT here — it's a public var in wrangler.jsonc. See docs/secrets.md.

# Auth (libs/auth) — BETTER_AUTH_SECRET must be >=32 chars. Generate one:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# OAuth providers (optional — leave blank to disable; email-OTP works without any)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Turnstile. TURNSTILE_DISABLED=true is the only bypass — without it, an absent
# TURNSTILE_SECRET_KEY makes the OTP-send endpoints refuse with 503 rather than run unprotected.
# TURNSTILE_SITE_KEY is the public client-side key (dev uses CF's always-pass test key).
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_DISABLED=true

# Geo-routing dev override — Miniflare doesn't set CF-IPCountry. Set to a configured country code (DZ, EG, SA)
# to test the geo-redirect for that market. Leave unset → default (Algeria).
DEV_GEO=

# Mapbox public token (client-side — safe to expose). Get one at account.mapbox.com
MAPBOX_TOKEN=

# Telegram meetup groups (P1-025). A bot username and a webhook secret switch the feature on. With no
# TELEGRAM_BOT_TOKEN, development runs against the recording provider and nothing reaches Telegram.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
