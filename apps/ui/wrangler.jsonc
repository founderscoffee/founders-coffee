{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "founders-coffee-ui",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },

  // Durable Objects must be SQLite-backed: key-value backed namespaces can no longer be created
  // (Cloudflare changelog 2026-07-09) and the Workers Free plan never supported them. Both classes
  // only use the `ctx.storage.get/put` KV API, which SQLite-backed objects implement natively.
  // `script_name` is deliberately absent — the DO classes live in THIS script, and naming it would
  // pin every environment to the production script.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EventLiveDO"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimiterDO"] },
  ],

  // ── Top-level = local dev (`vite dev`, Miniflare) ────────────────────────────────────────────
  // Deploys always target a named environment below, so nothing here reaches Cloudflare.
  // `database_id` is unused by Miniflare, which keys local D1 off `database_name`.
  "vars": {
    "APP_URL": "http://localhost:3000",
    "APP_ENVIRONMENT": "development",
    "MAIL_FROM": "no-reply@founders.coffee",
  },
  "send_email": [{ "name": "EMAIL" }],
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "founders-coffee-metrics" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "founders-coffee-db-staging",
      "database_id": "LOCAL_DEV_ONLY",
      "migrations_dir": "../../libs/db/migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "PROFILE_ASSETS", "bucket_name": "founders-coffee-assets-dev" },
  ],
  "images": { "binding": "IMAGES" },
  "durable_objects": {
    "bindings": [
      { "name": "EVENT_LIVE", "class_name": "EventLiveDO" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiterDO" },
    ],
  },

  // ── Deploy environments ──────────────────────────────────────────────────────────────────────
  // Bindings (`vars`, `durable_objects`, `d1_databases`, `send_email`) are non-inheritable and are
  // restated per environment on purpose. Selected at BUILD time via `CLOUDFLARE_ENV` — the
  // Cloudflare Vite plugin flattens the chosen environment into the deploy config, so
  // `wrangler deploy` takes no `--env` flag for this app.
  "env": {
    "staging": {
      "name": "founders-coffee-ui-staging",
      "workers_dev": true,
      "routes": [
        { "pattern": "staging.founders.coffee", "custom_domain": true },
      ],
      // A staged release gate cannot sign in on its own: codes are stored hashed and mailed rather
      // than printed. `OTP_ECHO=true` makes src/lib/otp-echo.ts write one to the log, and only for a
      // recipient in the reserved @e2e.invalid domain on a non-production environment. It is set for
      // the window of a run and removed again, never left standing — EC-10 is signed off, so it is
      // absent here.
      "vars": {
        "APP_URL": "https://staging.founders.coffee",
        "APP_ENVIRONMENT": "staging",
        "MAIL_FROM": "no-reply@founders.coffee",
        "CSP_ENFORCED": "true",
      },
      "send_email": [{ "name": "EMAIL" }],
      "analytics_engine_datasets": [
        { "binding": "ANALYTICS", "dataset": "founders-coffee-metrics" },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "founders-coffee-db-staging",
          "database_id": "cbbba018-a4e3-491a-9a02-7995aa45315b",
          "migrations_dir": "../../libs/db/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PROFILE_ASSETS",
          "bucket_name": "founders-coffee-assets-staging",
        },
      ],
      "images": { "binding": "IMAGES" },
      "durable_objects": {
        "bindings": [
          { "name": "EVENT_LIVE", "class_name": "EventLiveDO" },
          { "name": "RATE_LIMITER", "class_name": "RateLimiterDO" },
        ],
      },
    },
    "production": {
      "name": "founders-coffee-ui-production",
      "workers_dev": false,
      "routes": [{ "pattern": "founders.coffee", "custom_domain": true }],
      "vars": {
        "APP_URL": "https://founders.coffee",
        "APP_ENVIRONMENT": "production",
        "MAIL_FROM": "no-reply@founders.coffee",
        "CSP_ENFORCED": "true",
      },
      "send_email": [{ "name": "EMAIL" }],
      "analytics_engine_datasets": [
        { "binding": "ANALYTICS", "dataset": "founders-coffee-metrics" },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "founders-coffee-db-production",
          "database_id": "7685fda1-7bc0-4907-a37a-a77e8daa5ecb",
          "migrations_dir": "../../libs/db/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PROFILE_ASSETS",
          "bucket_name": "founders-coffee-assets-production",
        },
      ],
      "images": { "binding": "IMAGES" },
      "durable_objects": {
        "bindings": [
          { "name": "EVENT_LIVE", "class_name": "EventLiveDO" },
          { "name": "RATE_LIMITER", "class_name": "RateLimiterDO" },
        ],
      },
    },
  },
}
