{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "founders-coffee-dashboard",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },

  // Top-level = local dev. The sponsor portal (P3) has no server-fns wired yet, so it carries no
  // D1 or auth bindings; those are added in the same change that wires them.
  "vars": { "APP_URL": "http://localhost:3001" },

  "env": {
    "staging": {
      "name": "founders-coffee-dashboard-staging",
      "workers_dev": true,
      "routes": [
        { "pattern": "app-staging.founders.coffee", "custom_domain": true },
      ],
      "vars": { "APP_URL": "https://app-staging.founders.coffee" },
    },
    // Deliberately routeless. The sponsor portal is future roadmap work, outside the
    // community-building release, and the first production deploy published its shell on
    // `app.founders.coffee` as a side effect of deploying all four Workers together — which is
    // exactly the "presented as launched" the release strategy forbids. The Worker still deploys
    // so the environment stays exercised; it just answers nothing. Restore the route in the same
    // change that makes the portal real, and re-create the custom domain with it.
    "production": {
      "name": "founders-coffee-dashboard-production",
      "workers_dev": false,
      "vars": { "APP_URL": "https://app.founders.coffee" },
    },
  },
}
