{
  "name": "dashboard",
  "projectType": "application",
  "sourceRoot": "apps/dashboard/src",
  "prefix": "founders-coffee",
  "tags": ["type:app", "domain:dashboard"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "generate-routes" }],
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "apps/dashboard"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build && wrangler deploy",
        "cwd": "apps/dashboard"
      }
    },
    "generate-routes": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsr generate",
        "cwd": "apps/dashboard"
      }
    }
  }
}
