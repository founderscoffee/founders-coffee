{
  "name": "worker-jobs-test",
  "main": "./src/index.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "MAIL_FROM": "no-reply@founders.coffee",
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "db", "database_id": "test" },
  ],
  "r2_buckets": [
    { "binding": "PROFILE_ASSETS", "bucket_name": "profile-assets-test" },
  ],
  "send_email": [
    { "name": "EMAIL", "allowed_destination_addresses": ["ok@example.com"] },
  ],
  "queues": {
    "consumers": [
      { "queue": "founders-coffee-notifications" },
      { "queue": "founders-coffee-notifications-staging" },
      { "queue": "founders-coffee-embeddings-jobs" },
      { "queue": "founders-coffee-reconcile" },
      { "queue": "not-one-of-ours" },
    ],
  },
}
