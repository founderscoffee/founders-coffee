{
  "name": "worker-jobs",
  "projectType": "application",
  "sourceRoot": "apps/worker-jobs/src",
  "prefix": "founders-coffee",
  "tags": ["type:app", "domain:worker-jobs", "layer:server"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "apps/worker-jobs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "apps/worker-jobs"
      }
    },
    "deploy:staging": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler deploy --env staging",
        "cwd": "apps/worker-jobs"
      }
    },
    "deploy:production": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler deploy --env production",
        "cwd": "apps/worker-jobs"
      }
    },
    "migrate:staging": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler d1 migrations apply founders-coffee-db-staging --remote --env staging",
        "cwd": "apps/worker-jobs"
      }
    },
    "migrate:production": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler d1 migrations apply founders-coffee-db-production --remote --env production",
        "cwd": "apps/worker-jobs"
      }
    },
    "migrate:local": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler d1 migrations apply founders-coffee-db-staging --local",
        "cwd": "apps/worker-jobs"
      }
    }
  }
}
