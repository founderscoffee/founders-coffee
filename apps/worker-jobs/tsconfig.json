{
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.fixtures.ts", "src/setup.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "@cloudflare/workers-types"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "references": [
    {
      "path": "../../libs/domain"
    },
    {
      "path": "../../libs/server-fns"
    },
    {
      "path": "../../libs/notifications"
    },
    {
      "path": "../../libs/email"
    },
    {
      "path": "../../libs/core"
    },
    {
      "path": "../../libs/observability"
    },
    {
      "path": "../../libs/db"
    },
    {
      "path": "../../libs/infra"
    }
  ]
}
